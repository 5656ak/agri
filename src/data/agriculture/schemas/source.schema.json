{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchSourceSchema",
  "type": "object",
  "required": [
    "source_id",
    "institution",
    "document_title",
    "source_type",
    "verification_status"
  ],
  "properties": {
    "source_id": { "type": "string" },
    "institution": { "type": "string" },
    "document_title": { "type": "string" },
    "publication_year": { "type": ["string", "number", "null"] },
    "revision_year": { "type": ["string", "number", "null"] },
    "source_type": {
      "type": "string",
      "enum": [
        "ICAR",
        "ICAR_INSTITUTE",
        "KVK",
        "STATE_AGRICULTURAL_UNIVERSITY",
        "GOVERNMENT_DEPARTMENT",
        "SOIL_HEALTH_CARD",
        "CIBRC"
      ]
    },
    "official_url": { "type": ["string", "null"] },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "DEMO", "PENDING_VERIFICATION"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
